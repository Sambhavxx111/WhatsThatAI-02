generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Tool {
  id          Int           @id @default(autoincrement())
  name        String        @db.VarChar(255)
  slug        String?       @unique(map: "slug") @db.VarChar(255)
  description String?       @db.Text
  category    String?       @db.VarChar(100)
  pricing     tools_pricing?
  websiteUrl  String?       @map("website_url") @db.Text
  logoUrl     String?       @map("logo_url") @db.Text
  tags        Json?
  active      Boolean?      @default(true) @db.TinyInt
  source      String?       @default("manual") @db.VarChar(50)
  status      tools_status? @default(approved)
  createdAt   DateTime?     @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt   DateTime?     @default(now()) @map("updated_at") @db.Timestamp(0)
  reviews     Review[]
  activity    UserActivity[]
  likes       UserLike[]

  @@map("tools")
}

model User {
  id                 Int                 @id @default(autoincrement())
  name               String?             @db.VarChar(255)
  email              String              @unique @db.VarChar(255)
  password           String              @db.VarChar(255)
  profileImageUrl    String?             @map("profile_image_url") @db.Text
  role               user_role           @default(user)
  emailVerifiedAt    DateTime?           @map("email_verified_at") @db.Timestamp(0)
  createdAt          DateTime?           @default(now()) @map("created_at") @db.Timestamp(0)
  reviews            Review[]
  activity           UserActivity[]
  likes              UserLike[]
  adminAuditLogs     AdminAuditLog[]
  authSessions       AuthSession[]
  securityLogs       SecurityLog[]
  verificationTokens VerificationToken[]

  @@map("users")
}

model Review {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  toolId    Int       @map("tool_id")
  rating    Int
  review    String?   @db.Text
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamp(0)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade, map: "fk_reviews_user")
  tool      Tool      @relation(fields: [toolId], references: [id], onDelete: Cascade, map: "fk_reviews_tool")

  @@unique([userId, toolId], map: "user_tool_review_unique")
  @@index([toolId], map: "reviews_tool_id_idx")
  @@map("reviews")
}

model UserActivity {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  toolId    Int       @map("tool_id")
  action    String    @db.VarChar(50)
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamp(0)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade, map: "fk_user_activity_user")
  tool      Tool      @relation(fields: [toolId], references: [id], onDelete: Cascade, map: "fk_user_activity_tool")

  @@index([userId], map: "user_activity_user_id_idx")
  @@index([toolId], map: "user_activity_tool_id_idx")
  @@map("user_activity")
}

model UserLike {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  toolId    Int       @map("tool_id")
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamp(0)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade, map: "fk_user_likes_user")
  tool      Tool      @relation(fields: [toolId], references: [id], onDelete: Cascade, map: "fk_user_likes_tool")

  @@unique([userId, toolId], map: "user_tool_like_unique")
  @@index([userId], map: "user_likes_user_id_idx")
  @@index([toolId], map: "user_likes_tool_id_idx")
  @@map("user_likes")
}

model AdminAuditLog {
  id        Int                @id @default(autoincrement())
  adminId   Int                @map("admin_id")
  action    admin_audit_action
  ipAddress String?            @map("ip_address") @db.VarChar(255)
  createdAt DateTime?          @default(now()) @map("created_at") @db.Timestamp(0)
  admin     User               @relation(fields: [adminId], references: [id], onDelete: Cascade, map: "fk_admin_audit_logs_user")

  @@index([adminId], map: "admin_audit_logs_admin_id_idx")
  @@index([action], map: "admin_audit_logs_action_idx")
  @@map("admin_audit_logs")
}

model AuthSession {
  id               String    @id @default(cuid()) @db.VarChar(191)
  userId           Int       @map("user_id")
  refreshTokenHash String    @map("refresh_token_hash") @db.VarChar(255)
  expiresAt        DateTime  @map("expires_at") @db.Timestamp(0)
  lastUsedAt       DateTime? @map("last_used_at") @db.Timestamp(0)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamp(0)
  userAgent        String?   @map("user_agent") @db.VarChar(512)
  ipAddress        String?   @map("ip_address") @db.VarChar(255)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamp(0)
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade, map: "fk_auth_sessions_user")

  @@index([userId], map: "auth_sessions_user_id_idx")
  @@index([expiresAt], map: "auth_sessions_expires_at_idx")
  @@map("auth_sessions")
}

model VerificationToken {
  id         String                  @id @default(cuid()) @db.VarChar(191)
  userId     Int?                    @map("user_id")
  email      String                  @db.VarChar(255)
  type       verification_token_type
  tokenHash  String                  @map("token_hash") @db.VarChar(255)
  expiresAt  DateTime                @map("expires_at") @db.Timestamp(0)
  consumedAt DateTime?               @map("consumed_at") @db.Timestamp(0)
  metadata   Json?
  createdAt  DateTime                @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt  DateTime                @updatedAt @map("updated_at") @db.Timestamp(0)
  user       User?                   @relation(fields: [userId], references: [id], onDelete: Cascade, map: "fk_verification_tokens_user")

  @@index([email, type], map: "verification_tokens_email_type_idx")
  @@index([expiresAt], map: "verification_tokens_expires_at_idx")
  @@map("verification_tokens")
}

model SecurityLog {
  id        String    @id @default(cuid()) @db.VarChar(191)
  userId    Int?      @map("user_id")
  event     String    @db.VarChar(100)
  ip        String?   @db.VarChar(255)
  userAgent String?   @map("user_agent") @db.VarChar(512)
  path      String?   @db.VarChar(255)
  method    String?   @db.VarChar(16)
  status    Int?
  metadata  Json?
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamp(0)
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull, map: "fk_security_logs_user")

  @@index([createdAt], map: "security_logs_created_at_idx")
  @@index([event], map: "security_logs_event_idx")
  @@index([userId], map: "security_logs_user_id_idx")
  @@index([ip], map: "security_logs_ip_idx")
  @@map("security_logs")
}
enum tools_pricing {
  free
  freemium
  paid
}

enum tools_status {
  approved
  pending
  rejected
}

enum user_role {
  user
  admin
}

enum admin_audit_action {
  admin_login
  tool_approval
  tool_rejection
  tool_deletion
}

enum verification_token_type {
  email_verification
  admin_mfa
}

